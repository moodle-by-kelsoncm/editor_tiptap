{{!
    @template editor_tiptap/link_dialog

    Body of the insert link dialog of the TipTap editor.

    Context variables required for this template:
    * label - Label of the URL field.

    Example context (json):
    {
        "label": "URL"
    }
}}
<div class="mb-3">
    <label class="form-label" for="editor_tiptap-linkurl-{{uniqid}}">{{label}}</label>
    <input type="url" class="form-control" id="editor_tiptap-linkurl-{{uniqid}}"
           data-region="editor_tiptap-linkurl" placeholder="https://" required>
</div>
